{
  "expo": {
    "name": "简校园",
    "slug": "SimpleUniversity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f4f7f6"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIDesignRequiresCompatibility": false,
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "io.github.xiguac.simpleuniversity"
    },
    "android": {
      "package": "io.github.xiguac.simpleuniversity",
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#f4f7f6"
      }
    },
    "web": {
      "favicon": "./icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "c3ff43ba-9bd6-43b7-adc3-a185f5c6b959"
      }
    }
  }
}
